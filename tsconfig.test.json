{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "around": false
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/__tests__/**/*.ts"]
}
