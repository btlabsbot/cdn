{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": ".",
  "testMatch": ["**/api-gateway/**/*.test.ts"],
  "testPathIgnorePatterns": ["/node_modules/"],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "skipLibCheck": true,
          "strict": false
        },
        "diagnostics": false
      }
    ]
  }
}