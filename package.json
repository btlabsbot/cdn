{
  "name": "lynxnodes-cdn",
  "version": "1.0b",
  "private": true,
  "bin": {
    "lynxcdn": "scripts/lynxcdn.js"
  },
  "workspaces": [
    "packages/shared",
    "packages/cdn-engine",
    "packages/api-gateway",
    "packages/lynx-hub"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:gateway": "cross-env PORT=3000 npm run dev -w @lynxnodes/api-gateway",
    "dev:cdn-engine": "cross-env PORT=8080 GATEWAY_URL=http://localhost:3000 npm run dev -w @lynxnodes/cdn-engine",
    "dev:hub": "npm run dev -w @lynxnodes/lynx-hub",
    "lynxcdn": "node scripts/lynxcdn.js"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  }
}
